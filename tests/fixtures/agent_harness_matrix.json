    {"id":"selection-parameters","prompt":"检查这个 avatar 的 Expression Parameters 使用情况。","expectedTool":"vrcforge_scan_parameters","forbiddenTools":["vrcforge_list_avatars"]},
    {"id":"selection-fx","prompt":"读取 FX Animator 的层、状态和参数。","expectedTool":"vrcforge_scan_fx_animator","forbiddenTools":["vrcforge_health"]},
    {"id":"selection-controls","prompt":"扫描这个 avatar 的 expression menu controls 及关联参数。","expectedTool":"vrcforge_scan_avatar_controls","forbiddenTools":["vrcforge_list_avatars"]},
    {"id":"selection-sdk-performance","prompt":"计算这个 VRChat avatar 的 SDK performance rating。","expectedTool":"vrcforge_scan_avatar_performance","forbiddenTools":["vrcforge_list_avatars","vrcforge_scan_thry_avatar_performance"]},
    {"id":"selection-memory-performance","prompt":"计算这个 avatar 的 Thry VRAM 和 mesh memory。","expectedTool":"vrcforge_scan_thry_avatar_performance","forbiddenTools":["vrcforge_list_avatars","vrcforge_scan_avatar_performance"]},
    {"id":"selection-descriptor","prompt":"读取这个 avatar 的 VRCAvatarDescriptor 视点和 playable layers。","expectedTool":"vrcforge_read_avatar_descriptor","forbiddenTools":["vrcforge_list_avatars"]},
    {"id":"selection-items","prompt":"列出 avatar hierarchy 里的对象和组件类型。","expectedTool":"vrcforge_scan_avatar_items","forbiddenTools":["vrcforge_list_avatars","vrcforge_get_gameobject"]},
    {"id":"selection-unity-status","prompt":"检查 Unity MCP 是否已连接。","expectedTool":"vrcforge_unity_status","forbiddenTools":[]},
    {"id":"selection-avatar-list","prompt":"列出当前 Unity 项目里的所有 avatar。","expectedTool":"vrcforge_list_avatars","forbiddenTools":[]},
    {"id":"selection-runtime-health","prompt":"检查 VRCForge 后端健康状态。","expectedTool":"vrcforge_health","forbiddenTools":[]}
