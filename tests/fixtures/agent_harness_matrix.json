    {"id":"negative-manual-fx-plan","kind":"negative","prompt":"给我一个手动检查 FX Animator 的计划，不要读取项目。","expectedTool":"","expectedActionKind":"none","forbiddenTools":["vrcforge_scan_fx_animator"]},
    {"id":"negative-creative-materials","kind":"negative","prompt":"给 avatar 材质起几个名字，不要扫描。","expectedTool":"","expectedActionKind":"none","forbiddenTools":["vrcforge_scan_materials"]},
    {"id":"negative-ambiguous-avatar","kind":"negative","prompt":"帮我处理 avatar，但先不要执行工具。","expectedTool":"","expectedActionKind":"none","forbiddenTools":[]},
    {"id":"negative-clarification","kind":"negative","prompt":"用户只说“检查一下”，你应该怎么追问？","expectedTool":"","expectedActionKind":"none","forbiddenTools":[]},
    {"id":"negative-code-example","kind":"negative","prompt":"给一个 C# 创建 GameObject 的示例代码，不要写入或读取 Unity。","expectedTool":"","expectedActionKind":"none","exposureLayer":"execution","forbiddenTools":[]}
  ],
  "completionCases": [
    {"id":"completion-read-ok","write":false,"result":{"ok":true,"summary":"Read completed."},"expectedStatus":"ok","expectedNextStep":"done"},
    {"id":"completion-nested-failure","write":false,"result":{"ok":true,"status":"executed","result":{"ok":false,"status":"failed","error":"Read failed."}},"expectedStatus":"failed","expectedNextStep":"tool_failed"},
    {"id":"completion-approval-pending","write":true,"result":{"ok":true,"status":"pending_approval","approval":{"id":"approval-1"}},"expectedStatus":"needs_user_action","expectedNextStep":"needs_user_action"},
    {"id":"completion-readback-failed","write":true,"result":{"ok":true,"status":"applied","readbackVerified":false},"expectedStatus":"needs_user_action","expectedNextStep":"needs_user_action"},
    {"id":"completion-readback-passed-visual-deferred","write":true,"result":{"ok":true,"status":"applied","readbackVerified":true,"visualProof":{"status":"unavailable"}},"expectedStatus":"ok","expectedNextStep":"done"},
    {"id":"completion-required-visual-missing","write":true,"result":{"ok":true,"status":"applied","readbackVerified":true,"visualProof":{"status":"unavailable"},"verification":{"required":["visual"]}},"expectedStatus":"needs_user_action","expectedNextStep":"needs_user_action"},
    {"id":"completion-shell-failed","write":true,"result":{"ok":false,"status":"failed","error":"Shell command failed."},"expectedStatus":"failed","expectedNextStep":"tool_failed"}
  ],
  "loopCases": [
    {"id":"loop-llm-exact-claim","objective":"Inspect materials","claim":"exact","actions":[{"kind":"skill","tool":"vrcforge_scan_materials","arguments":{"avatarPath":"Avatar"},"result":{"ok":true,"status":"executed","summary":"Materials scanned."}}],"expectedNextStep":"done","expectedTaskStatus":"completed"},
    {"id":"loop-llm-missing-claim","objective":"Inspect materials","claim":"missing","actions":[{"kind":"skill","tool":"vrcforge_scan_materials","arguments":{"avatarPath":"Avatar"},"result":{"ok":true,"status":"executed","summary":"Materials scanned."}}],"expectedNextStep":"completion_unverified","expectedTaskStatus":"completion_unverified"},
    {"id":"loop-llm-unknown-claim","objective":"Inspect materials","claim":"unknown","actions":[{"kind":"skill","tool":"vrcforge_scan_materials","arguments":{"avatarPath":"Avatar"},"result":{"ok":true,"status":"executed","summary":"Materials scanned."}}],"expectedNextStep":"completion_unverified","expectedTaskStatus":"completion_unverified"},
    {"id":"loop-shell-running","objective":"Run the worker","claim":"exact","actions":[{"kind":"shell","tool":"shell","arguments":{"command":"python worker.py"},"result":{"ok":true,"status":"running","session":{"sessionId":"shell-1","status":"running"}}}],"expectedNextStep":"waiting_for_tool","expectedTaskStatus":"running"},
    {"id":"loop-shell-running-then-terminal","objective":"Run the worker","claim":"exact","actions":[{"kind":"shell","tool":"shell","arguments":{"command":"python worker.py"},"result":{"ok":true,"status":"running","session":{"sessionId":"shell-1","status":"running"}}},{"kind":"shell","tool":"shell","arguments":{"command":"python worker.py"},"result":{"ok":true,"status":"finished","result":{"exitCode":0,"stdout":"done","stderr":""}}}],"expectedNextStep":"done","expectedTaskStatus":"completed"},
    {"id":"loop-unity-readback-missing","objective":"Create an object","claim":"exact","actions":[{"kind":"write","tool":"vrcforge_create_gameobject","write":true,"arguments":{"name":"Probe"},"result":{"ok":true,"status":"applied","persistedReadback":false,"sceneSaved":true}}],"expectedNextStep":"needs_user_action","expectedTaskStatus":"needs_user_action"},
    {"id":"loop-unity-readback-passed","objective":"Create an object","claim":"exact","actions":[{"kind":"write","tool":"vrcforge_create_gameobject","write":true,"arguments":{"name":"Probe"},"result":{"ok":true,"status":"applied","persistedReadback":true,"sceneSaved":true,"consoleVerified":true}}],"expectedNextStep":"done","expectedTaskStatus":"completed"},
    {"id":"loop-multiple-actions-exact","objective":"Inspect materials and parameters","claim":"exact","actions":[{"kind":"skill","tool":"vrcforge_scan_materials","arguments":{"avatarPath":"Avatar"},"result":{"ok":true,"status":"executed"}},{"kind":"skill","tool":"vrcforge_scan_parameters","arguments":{"avatarPath":"Avatar"},"result":{"ok":true,"status":"executed"}}],"expectedNextStep":"done","expectedTaskStatus":"completed"},
    {"id":"loop-multiple-actions-partial","objective":"Inspect materials and parameters","claim":"first_only","actions":[{"kind":"skill","tool":"vrcforge_scan_materials","arguments":{"avatarPath":"Avatar"},"result":{"ok":true,"status":"executed"}},{"kind":"skill","tool":"vrcforge_scan_parameters","arguments":{"avatarPath":"Avatar"},"result":{"ok":true,"status":"executed"}}],"expectedNextStep":"completion_unverified","expectedTaskStatus":"completion_unverified"}
  ],
  "chainCases": [
    {
      "id": "chain-correction-supersedes-failure",
      "objective": "Inspect the selected avatar materials",
      "requirements": [{"kind":"skill","tool":"vrcforge_scan_materials","arguments":{"avatarPath":"Wrong"}}],
      "actions": [
        {"key":"wrong","kind":"skill","tool":"vrcforge_scan_materials","arguments":{"avatarPath":"Wrong"},"result":{"ok":false,"status":"failed","error":{"type":"input","code":"avatar_not_found","likelyCauses":["Wrong avatar path"],"nextActions":["Use the selected avatar path"],"retryable":true}}},
        {"key":"fixed","correctionFor":"wrong","kind":"skill","tool":"vrcforge_scan_materials","arguments":{"avatarPath":"Avatar"},"result":{"ok":true,"status":"executed","summary":"Materials scanned."}}
      ],
      "claim": "exact",
      "expectedNextStep": "done",
      "expectedTaskStatus": "completed",
      "expectedActionStatuses": {"wrong":"superseded","fixed":"completed"},
      "expectedErrorCodes": {"wrong":"avatar_not_found"}
    },
    {
      "id": "chain-unrelated-success-does-not-clear-failure",
      "objective": "Inspect materials",
      "actions": [
        {"key":"materials","kind":"skill","tool":"vrcforge_scan_materials","arguments":{},"result":{"ok":false,"status":"failed","error":{"type":"unity","code":"material_scan_failed","retryable":true}}},
        {"key":"health","kind":"skill","tool":"vrcforge_health","arguments":{},"result":{"ok":true,"status":"executed"}}
      ],
      "claim": "exact",
      "expectedNextStep": "tool_failed",
      "expectedTaskStatus": "failed",
      "expectedActionStatuses": {"materials":"failed","health":"completed"},
      "expectedErrorCodes": {"materials":"material_scan_failed"}
    },
    {
      "id": "chain-one-correction-does-not-hide-other-failure",
      "objective": "Inspect materials and parameters",
      "actions": [
        {"key":"materials","kind":"skill","tool":"vrcforge_scan_materials","arguments":{},"result":{"ok":false,"status":"failed","error":{"type":"unity","code":"materials_failed"}}},
        {"key":"parameters","kind":"skill","tool":"vrcforge_scan_parameters","arguments":{"avatarPath":"Wrong"},"result":{"ok":false,"status":"failed","error":{"type":"input","code":"parameters_target_failed"}}},
        {"key":"parameters_fixed","correctionFor":"parameters","kind":"skill","tool":"vrcforge_scan_parameters","arguments":{"avatarPath":"Avatar"},"result":{"ok":true,"status":"executed"}}
      ],
      "claim": "exact",
      "expectedNextStep": "tool_failed",
      "expectedTaskStatus": "failed",
      "expectedActionStatuses": {"materials":"failed","parameters":"superseded","parameters_fixed":"completed"}
    },
    {
      "id": "chain-declared-verifier-blocks-false-success",
      "objective": "Persist the Unity scene change",
      "requirements": [{"kind":"write","tool":"fixture_unity_write","arguments":{"target":"Avatar"},"verificationProfile":"persisted_scene_write"}],
      "actions": [{"key":"write","kind":"write","tool":"fixture_unity_write","write":true,"arguments":{"target":"Avatar"},"result":{"ok":true,"status":"applied","persistedReadback":true,"sceneSaved":false}}],
      "claim": "exact",
      "expectedNextStep": "needs_user_action",
      "expectedTaskStatus": "needs_user_action",
      "expectedActionStatuses": {"write":"needs_user_action"}
    },
    {
      "id": "chain-declared-verifier-allows-persisted-result",
      "objective": "Persist the Unity scene change",
      "requirements": [{"kind":"write","tool":"fixture_unity_write","arguments":{"target":"Avatar"},"verificationProfile":"persisted_scene_write"}],
      "actions": [{"key":"write","kind":"write","tool":"fixture_unity_write","write":true,"arguments":{"target":"Avatar"},"result":{"ok":true,"status":"applied","persistedReadback":true,"sceneSaved":true}}],
      "claim": "exact",
      "expectedNextStep": "done",
      "expectedTaskStatus": "completed",
      "expectedActionStatuses": {"write":"completed"}
    },
    {
      "id": "chain-console-and-multi-angle-evidence-complete-the-task",
      "objective": "Persist and visually verify the Unity scene change",
      "requirements": [
        {"kind":"write","tool":"fixture_unity_write","arguments":{"target":"Avatar"},"verificationProfile":"persisted_scene_write_console"},
        {"kind":"write","tool":"vrcforge_capture_multi_screenshot","arguments":{"angles":["front","back"]},"verificationProfile":"canonical_tool_result"},
        {"kind":"skill","tool":"vrcforge_vision_audit_multi","arguments":{"captureReceipt":"managed-receipt"},"verificationProfile":"multi_angle_visual"}
      ],
      "actions": [
        {"key":"write","kind":"write","tool":"fixture_unity_write","write":true,"arguments":{"target":"Avatar"},"result":{"ok":true,"status":"applied","persistedReadback":true,"sceneSaved":true,"consoleVerified":true}},
        {"key":"capture","kind":"write","tool":"vrcforge_capture_multi_screenshot","write":true,"arguments":{"angles":["front","back"]},"result":{"ok":true,"status":"applied","evidence":[{"ref":"visual-fixture-1","kind":"managed_visual_capture"}]}},
        {"key":"visual","kind":"skill","tool":"vrcforge_vision_audit_multi","arguments":{"captureReceipt":"managed-receipt"},"result":{"ok":true,"status":"executed","visualVerified":true,"coverageComplete":true,"captureEvidenceVerified":true,"evidence":[{"ref":"visual-fixture-1","kind":"managed_visual_capture"}]}}
      ],
      "claim": "exact",
      "expectedNextStep": "done",
      "expectedTaskStatus": "completed",
      "expectedActionStatuses": {"write":"completed","capture":"completed","visual":"completed"}
    }
  ]
}
