    {"id":"selection-materials-not-blendshapes","kind":"positive","prompt":"Scan the avatar materials, not its blendshapes.","expectedTool":"vrcforge_scan_materials","expectedActionKind":"skill","forbiddenTools":["vrcforge_scan_blendshapes"]},
    {"id":"selection-unity-not-health","kind":"positive","prompt":"Check Unity connection status, not VRCForge backend health.","expectedTool":"vrcforge_unity_status","expectedActionKind":"skill","forbiddenTools":["vrcforge_health"]},
    {"id":"selection-sdk-not-vram","kind":"positive","prompt":"Calculate the avatar SDK performance rating, not its VRAM.","expectedTool":"vrcforge_scan_avatar_performance","expectedActionKind":"skill","forbiddenTools":["vrcforge_scan_thry_avatar_performance"]},
    {"id":"selection-single-not-multi","kind":"positive","prompt":"Capture one current screenshot, not multi-angle coverage.","expectedTool":"vrcforge_capture_screenshot","expectedActionKind":"write","exposureLayer":"execution","forbiddenTools":["vrcforge_capture_multi_screenshot"]},
