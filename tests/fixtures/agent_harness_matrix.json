    {"id":"negative-status-term","kind":"negative","prompt":"“截图捕获状态”这个词是什么意思？不要检查。","expectedTool":"","expectedActionKind":"none","forbiddenTools":["vrcforge_capture_status"]},
    {"id":"negative-compare-capture","kind":"negative","prompt":"比较单张截图和多角度截图，不要拍照。","expectedTool":"","expectedActionKind":"none","exposureLayer":"execution","forbiddenTools":["vrcforge_capture_screenshot","vrcforge_capture_multi_screenshot"]},
