{
  "schema": "vrcforge.one_five_owner_facade_manifest.v1",
  "enforceFromVersion": "1.5.0",
  "policy": {
    "finalDeclaredMigrationHits": 0,
    "finalUndeclaredMigrationSeams": 0,
    "rootOrGatewayDelegateIsPublicApi": false,
    "typedExternalIoPortsRemainAllowed": true
  },
  "publicApiAllowlist": {
    "rule": "Preserve observable contracts, not Python root symbols kept only for migration or monkeypatching.",
    "contracts": [
      {
        "id": "fastapi-route-request-response-openapi",
        "identity": "HTTP method, route path, request and response schema, status semantics, and OpenAPI",
        "guardPaths": [
          "tests/fixtures/dashboard_composition_contract_v1.json",
          "tests/test_dashboard_composition.py"
        ]
      },
      {
        "id": "tauri-command-surface",
        "identity": "registered Tauri command names and their serialized request and response contracts",
        "guardPaths": [
          "src-tauri/src/main.rs",
          "tests/test_golden_path_preflight.py"
        ]
      },
      {
        "id": "cli-mcp-tool-surface",
        "identity": "CLI and MCP envelope schemas, tool ids, arguments, and exposure policy",
        "guardPaths": [
          "tests/test_agent_mcp_2026.py",
          "tests/test_mcp_trigger_selection.py"
        ]
      },
      {
        "id": "eventbus-surface",
        "identity": "EventBus event types and envelope schema",
        "guardPaths": [
          "tests/fixtures/dashboard_composition_contract_v1.json",
          "tests/test_dashboard_composition.py"
        ]
      },
      {
        "id": "persisted-disk-schemas",
        "identity": "durable schema ids, field meanings, scope, atomicity, and restart behavior",
        "guardPaths": [
          "tests/test_session_store_integrity.py",
          "tests/test_project_selection_persistence.py"
        ]
      },
      {
        "id": "genuine-imported-models",
        "identity": "dataclass and model imports used by modules outside the migration host",
        "guardPaths": [
          "tests/test_model_provider_adapters.py"
        ]
      }
    ]
  },
  "seamGroups": []
}
