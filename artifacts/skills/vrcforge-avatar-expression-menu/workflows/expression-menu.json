{
  "schema": "vrcforge.skill-package.workflow.v1",
  "mode": "approval_required",
  "boothAssetEvidenceContract": {
    "appliesBefore": ["install", "replace", "adapt", "assign_author_asset", "texture_change"],
    "candidateUrl": {
      "deriveFrom": ["asset_filename", "asset_folder_name", "user_supplied_product_number"],
      "verify": ["title", "author", "target_model_or_version"],
      "whenMissing": "report_capability_gap_and_stop_dependent_writes"
    },
    "readOrder": ["booth_product_description", "local_author_readme_install_notes_dependencies_usage"],
    "pageEvidence": {
      "bodyAndImagesMustBeReadable": true,
      "unreadableReasons": ["login_or_age_confirmation", "expired", "fetch_failed"],
      "onUnreadable": "report_not_read_and_stop_dependent_writes_allow_unrelated_read_only"
    },
    "textureRoles": ["full_base", "local_supplement", "overlay", "decal", "alpha", "mask"],
    "mainTextureRule": "never_replace_from_filename_or_similar_name_alone",
    "composition": "if_author_requires_compositing_propose_route_only_no_automatic_execution",
    "boundaries": ["do_not_download_paid_assets", "documentation_is_not_authorization"],
    "scope": "all_asset_types_current_decision_only_not_a_fixed_modelling_template",
    "publicReadBoundary": {
      "localTools": ["vrcforge_list_directory", "vrcforge_find_files", "vrcforge_read_text_file"],
      "hostProvidedWebAndImageReadRequired": true,
      "onMissing": "report_capability_gap_and_stop_dependent_writes"
    }
  },
  "selfContained": true,
  "requiresOtherSkills": [],
  "scope": [
    "expression_menu",
    "category",
    "submenu",
    "pagination",
    "expression_parameters",
    "control_readback"
  ],
  "uncertaintyPolicy": {
    "whenUnclear": [
      "expression_menu",
      "pagination",
      "parameter_type",
      "submenu_alias",
      "vrchat_menu_limit"
    ],
    "consult": [
      "mature_community_guides",
      "asset_author_instructions",
      "official_documentation"
    ],
    "onInsufficientEvidence": {
      "capabilityGap": true,
      "ready": false,
      "action": "stop_and_report"
    },
    "mustNot": [
      "guess",
      "invent_tools",
      "claim_unverified_support",
      "use_unauthorized_assets"
    ]
  },
  "communityContract": {
    "scopeComesFromUserRequestAndCurrentAvatar": true,
    "doNotAssumeUniversalRootOrCategoryOrder": true,
    "localReadDoesNotRequireFullMenuTreeExpansion": true,
    "maximumControlsPerPageIncludingNextPage": 8,
    "preserveOutOfScopeStructureAndFields": true,
    "parameterMustMatchControlAndAnimatorType": true
  },
  "steps": [
    {
      "name": "read_booth_asset_author_evidence_before_asset_change",
      "tool": "vrcforge_list_directory",
      "tools": ["vrcforge_find_files", "vrcforge_read_text_file"],
      "when": "an author asset, material, or texture is installed, replaced, adapted, or assigned, or its filename/folder carries a Booth/product number",
      "arguments": "locate the candidate Booth number and local author notes; require the host to provide readable product page and image evidence, classify each image role, and stop dependent writes when required page evidence is unavailable",
      "writes": false
    },
    {
      "name": "bind_exact_project_and_avatar",
      "tool": "vrcforge_list_avatars",
      "tools": [
        "vrcforge_read_avatar_descriptor",
        "vrcforge_get_asset_info"
      ],
      "scope": "descriptor_and_only_the_requested_menu_or_parameter_assets; do_not_expand_unrelated_menu_branches",
      "writes": false
    },
    {
      "name": "discover_only_the_requested_menu_branch_when_asset_path_is_unknown",
      "when": "descriptor and exact serialized menu references do not identify the user-requested branch",
      "tool": "vrcforge_scan_avatar_controls",
      "tools": [],
      "arguments": "projectPath and exact avatarPath; use returned menuPath only to locate the requested target and do not expand unrelated findings into scope",
      "writes": false
    },
    {
      "name": "ensure_expression_parameter_only_when_required_by_requested_control",
      "when": "the requested control needs a missing or explicitly changed parameter; derive its exact name, type and behavior from project evidence and user intent, present them in preview, and write only after that design is approved",
      "tool": "vrcforge_preview_ensure_expression_parameter",
      "tools": [
        "vrcforge_ensure_expression_parameter"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true
    },
    {
      "name": "manage_expression_menu_through_current_permission_policy",
      "tool": "vrcforge_preview_manage_expression_menu",
      "tools": [
        "vrcforge_manage_expression_menu"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true
    },
    {
      "name": "ensure_expression_menu_control_through_current_permission_policy",
      "tool": "vrcforge_preview_ensure_expression_menu_control",
      "tools": [
        "vrcforge_ensure_expression_menu_control"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true
    },
    {
      "name": "read_back_exact_requested_controls_and_parameters",
      "tool": "vrcforge_get_asset_info",
      "tools": [
        "vrcforge_get_asset_info",
        "vrcforge_scan_avatar_controls",
        "vrcforge_scan_parameters",
        "vrcforge_run_validation_report",
        "vrcforge_build_test_readiness"
      ],
      "scope": "requested_menu_paths_and_associated_parameters_only",
      "readMode": "Exact assetPath or GUID with includeText=true; require sourceComplete for serialized-field claims; if source is binary/unreadable, use avatarPath-scoped read-only scanners for requested control/parameter values and mark unavailable fields (such as icons) unverified.",
      "verify": ["control_name_type_parameter_value_icon_submenu_reference", "parameter_type_default_saved_synced", "only_approved_delta"],
      "writes": false
    }
  ],
  "approval": {
    "required": true,
    "owner": "runtime_supervision_layer",
    "scope": "one_exact_write_through_current_permission_policy"
  },
  "checkpoint": {
    "required": true
  },
  "rollback": {
    "required": true,
    "requiresSeparateApproval": true
  }
}
