{
  "schema": "vrcforge.skill-package.workflow.v1",
  "newBuildDefaults": {
    "requiresExplicitFromScratchRequest": true,
    "requiresVerifiedNoExistingWardrobeInScope": true,
    "excludedOperations": ["inspect_existing", "extend_existing", "repair_existing", "delete_existing"],
    "ambiguousScopeAction": "ask_before_selecting_branch",
    "emptyOrFailedReadDoesNotProveAbsence": true,
    "userRequirementsOverrideDefaults": true,
    "approvalBeforeWrites": true,
    "design": {
      "source": "current_user_confirmed_new_wardrobe_preferences",
      "preserveExistingStructureFirst": true,
      "missingPreferenceAction": "present_a_concrete_design_before_writes",
      "referenceProjectIsNotUniversalDefault": true,
      "organization": {"readableAndMaintainable": true, "clearCategories": true, "recognizableNames": true, "relatedObjectsAdjacent": true, "preferExistingConventions": true, "newScopeOnly": true, "beforeReorderReparentOrRename": ["animation_bindings", "bones", "component_relative_paths", "inbound_references"], "noUnapprovedExistingObjectMoves": true},
      "selector": {"source": "current_user_confirmed_preferences_or_approved_design", "intSkeletonOnlyWhenApproved": true, "boolFloatOrOtherTopologyUsesAtomicTools": true},
      "valueMapSource": "current_user_approved_design_not_project_fixture",
      "fx": {"source": "current_user_confirmed_preferences_or_approved_design", "writeDefaultsMustBeExplicitInPreview": true, "unverifiedReferenceSettingsMustNotBecomeDefaults": true},
      "animation": {"expectedEffectsSource": "current_user_approved_design", "mutualExclusionWhenRequested": true, "partsAndMorphsRequireFitEvidence": true, "animatedTransitionsRequireUserConfirmedTimeline": true},
      "menu": {"source": "current_user_confirmed_preferences_or_approved_design", "paginateWithinPlatformCapacity": true},
      "oneOutfitAtATime": true,
      "perOutfitReadbackAndRuntimeAcceptance": true
    }
  },
  "mode": "approval_required",
  "boothAssetEvidenceContract": {
    "appliesBefore": ["install", "replace", "adapt", "assign_author_asset", "texture_change"],
    "candidateUrl": {
      "deriveFrom": ["asset_filename", "asset_folder_name", "user_supplied_product_number"],
      "verify": ["title", "author", "target_model_or_version"],
      "whenMissing": "report_capability_gap_and_stop_dependent_writes"
    },
    "readOrder": ["booth_product_description", "local_author_readme_install_notes_dependencies_usage"],
    "pageEvidence": {
      "bodyAndImagesMustBeReadable": true,
      "unreadableReasons": ["login_or_age_confirmation", "expired", "fetch_failed"],
      "onUnreadable": "report_not_read_and_stop_dependent_writes_allow_unrelated_read_only"
    },
    "textureRoles": ["full_base", "local_supplement", "overlay", "decal", "alpha", "mask"],
    "mainTextureRule": "never_replace_from_filename_or_similar_name_alone",
    "composition": "if_author_requires_compositing_propose_route_only_no_automatic_execution",
    "boundaries": ["do_not_download_paid_assets", "documentation_is_not_authorization"],
    "scope": "all_asset_types_current_decision_only_not_a_fixed_modelling_template",
    "publicReadBoundary": {
      "localTools": ["vrcforge_list_directory", "vrcforge_find_files", "vrcforge_read_text_file"],
      "hostProvidedWebAndImageReadRequired": true,
      "onMissing": "report_capability_gap_and_stop_dependent_writes"
    }
  },
  "selfContained": true,
  "requiresOtherSkills": [],
  "scope": [
    "outfit_mount",
    "wardrobe",
    "expression_parameters",
    "fx_animator",
    "animation_curves",
    "morph_compensation",
    "conditional_head_object_fit",
    "expression_menu",
    "replacement_cleanup",
    "runtime_acceptance"
  ],
  "uncertaintyPolicy": {
    "whenUnclear": [
      "skeleton",
      "modular_avatar",
      "wardrobe_value_map",
      "expression_menu",
      "parameters",
      "fx_animator",
      "animation_matrix",
      "morph_value",
      "head_fit_necessity",
      "asset_license",
      "reference_closure"
    ],
    "consult": [
      "mature_community_guides",
      "asset_author_instructions",
      "official_documentation"
    ],
    "onInsufficientEvidence": {
      "after": "allowed_read_paths_or_actual_capability_or_task_budget_exhausted",
      "capabilityGap": true,
      "ready": false,
      "action": "stop_and_report_before_writes"
    },
    "mustNot": [
      "guess",
      "invent_tools",
      "claim_unverified_support",
      "use_unauthorized_assets",
      "infer_morph_values_from_names_alone"
    ]
  },
  "recognitionLoop": {
    "mode": "read_only_before_authoring",
    "classificationDoesNotProveBusinessPurpose": true,
    "crossCheck": ["menu_purpose", "actual_objects", "clip_effects"],
    "ambiguousDestinations": "preserve_all_candidates_inspect_before_claim_or_repair",
    "termination": {
      "queue": "finite_discovered_candidates_and_pages",
      "unchangedEvidence": "do_not_revisit_same_visited_key",
      "unattendedRun": "caller_must_declare_finite_time_or_call_budget",
      "recognitionOnly": "answer_requested_scope_without_entering_authoring"
    },
    "assumeAnyState": false,
    "assumeParameterNameOrType": false,
    "visitedKey": [
      "identityScope",
      "controller",
      "layer",
      "stateMachinePath",
      "resourceHash"
    ],
    "pageCursor": "independent_per_read_source",
    "stages": [
      {
        "name": "enter",
        "action": "bind_identity_resource_and_session_context",
        "readOnly": true
      },
      {
        "name": "read",
        "action": "read_one_candidate_page_or_state_machine_scope",
        "readOnly": true
      },
      {
        "name": "analyze",
        "action": "reconcile_parameters_conditions_dependencies_and_clip_effects",
        "readOnly": true
      },
      {
        "name": "judge",
        "outputs": [
          "confirmed",
          "rejected",
          "undetermined"
        ],
        "readOnly": true
      },
      {
        "name": "exit",
        "action": "persist_local_frame_evidence_and_reason",
        "readOnly": true
      },
      {
        "name": "next",
        "action": "continue_unvisited_candidate_or_page",
        "readOnly": true
      }
    ],
    "evidenceOutputs": [
      "confirmed",
      "rejected",
      "undetermined",
      "visited",
      "nextPageCursor",
      "completeness"
    ],
    "identityReadiness": {
      "beforeDomainReads": [
        "bind",
        "structuredContent.result.executionTarget",
        "resources.identityLockUri",
        "operationReceiptUri",
        "prompts/get(identityLockUri, sessionContextUri)"
      ],
      "requiredContextStatus": "ready_for_planning",
      "preserveFullExecutionTargetJson": true,
      "preserveTargetAndProvenanceOnAlternative": true,
      "onReadRejection": "choose_allowed_read_alternative_preserving_target_and_provenance"
    },
    "identityBinding": "same_absolute_projectPath_and_ExecutionTarget_per_call",
    "pagination": "follow_needed_pages_and_report_unread_scope",
    "cyclePolicy": "mark_undetermined_with_reason_and_continue_other_candidates",
    "localMissDoesNotEndGlobalScan": true,
    "anyStateIsOnlyAClue": true,
    "budgetExhaustion": {
      "persistQueueAndEvidence": true,
      "capabilityGap": true,
      "ready": false,
      "action": "stop_and_report"
    },
    "scanWardrobeIsOptionalClue": true,
    "confirmationRequiresFxAndClipEvidence": true,
    "missingFxStructureFieldsRemainUndetermined": [
      "entryExit",
      "blendTreeStructure",
      "drivers"
    ],
    "writesAllowed": false,
    "relevantEvidence": [
      "parameters",
      "menuBindings",
      "transitions",
      "conditions",
      "referencedMotions",
      "clipBindings",
      "runtimeObservations"
    ],
    "confirmationScope": "claims_about_animation_effects_only"
  },
  "communityWardrobeContract": {
    "applicability": {
      "appliesTo": "user_approved_authoring_design",
      "recognitionMode": "read_existing_any_supported_parameter_or_topology",
      "preserveExistingBoolFloatBlendTree": true,
      "noImplicitMigrationToInt": true
    },
    "projectBinding": {
      "everyToolCallRequiresAbsoluteProjectPath": true,
      "projectPathMustRemainConstant": true
    },
    "prefabInstanceAuthoring": {
      "beforeAnyInstanceModification": "place_one_imported_instance_then_immediately_read_preview_and_approved_completely_unpack",
      "tool": "vrcforge_unpack_prefab",
      "previewTool": "vrcforge_preview_unpack_prefab",
      "previewRequired": true,
      "placementOnlyArguments": {"manageWardrobe": false, "setupOutfit": false, "unpackPrefab": false},
      "existingPlacedOutfitsMustBeCheckedIndividually": true,
      "skipWhen": ["target_is_not_a_scene_prefab_instance", "target_is_already_unpacked"],
      "neverUnpack": ["imported_asset_package_file", "source_prefab_asset", "preview_generated_object", "unrelated_scene_object"],
      "mode": "completely",
      "identityFields": ["expectedGlobalObjectId", "expectedPrefabGuid", "expectedAssetDependencyHash", "expectedScenePath"],
      "previewResultFields": ["gameObjectPath", "unpackMode", "globalObjectId", "prefabGuid", "dependencyHash", "scenePath"],
      "writePreviewMustNotBeRequestedByToolParameter": true,
      "approvalAndCheckpointRequired": true,
      "rebindAfterUnpack": true,
      "persistedReadbackRequired": true,
      "preserveSourcePrefabAsset": true,
      "preserveAuthorModularAvatarComponents": true,
      "preserveAuthorSkeletonAndAnimationReferences": true,
      "materialPropertyWritesUseTheirOwnContract": true
    },
    "outfitAttachment": "select_tool_compatible_with_approved_design",
    "selector": {
      "source": "observed_evidence_and_explicit_user_approved_changes",
      "explicitApprovedArgumentsRequired": true,
      "preserveApprovedValuesAndAliases": true
    },
    "fx": {
      "existingVerifiedMustPreserve": true,
      "readbackRequiredFields": [
        "source",
        "destination",
        "conditions",
        "durationSeconds",
        "hasExitTime",
        "exitTime",
        "canTransitionToSelf",
        "writeDefaults"
      ],
      "newTopologyMustMatchUserConfirmedReference": true,
      "modifyOnlyWithConflictEvidence": true,
      "unrelatedLayersPreservedUnlessExplicitlyProvenObsolete": true
    },
    "animation": {
      "expectedEffectsSource": "observed_evidence_and_explicit_user_approved_changes",
      "repairStableValueOnlyWhenEvidenceDiffers": true,
      "transitionClipPolicy": {
        "preserveSourceTimeline": true,
        "changesRequireExplicitApproval": true
      },
      "bindingIdentityRequired": true,
      "noUnapprovedBindingDeletion": true,
      "morphValuesRequireEvidence": true,
      "rendererPropertyBlock": {
        "scope": "renderer_wide",
        "identityFields": [
          "rendererPath",
          "rendererComponentIndex",
          "materialIndex",
          "sharedMaterial.assetGuid"
        ],
        "oneCurvePerRendererProperty": true,
        "mustNotDuplicateCurvesPerMaterialSlot": true
      }
    },
    "protectedSystems": {
      "preserveAllUserConfiguredPhysics": true,
      "preserveVendorPhysBonesConstraintsAndColliders": true
    },
    "headObjects": {
      "refitOnlyWithMismatchEvidenceAndApproval": true,
      "fitImportedObjectLocallyOnly": true
    },
    "menu": {
      "preserveUserApprovedRootStructure": true,
      "designSource": "observed_evidence_and_explicit_user_approved_changes",
      "preserveOriginalModelContent": true,
      "preserveIconsLabelsLanguagesAndApprovedAliases": true
    },
    "runtimeEvidence": {
      "completeFramesRequired": true,
      "stateResourcePageChainRequired": true,
      "stateIdentityFields": [
        "jobId",
        "frameIndex",
        "sampleIndex",
        "unityFrame",
        "stateSetHash",
        "states"
      ],
      "selectionMustReportCountsAndIdentity": true,
      "observationLifecycle": {
        "requiresFiniteDurationAndFrameBudget": true,
        "pendingAction": "read_original_job_id_without_restart",
        "completedDoesNotMeanVisualAcceptance": true,
        "cleanup": "restore_user_approved_play_state_and_read_back"
      }
    },
    "faceTrackingAcceptance": {
      "serializedInstallAndConfiguration": "independent_edit_mode_readback",
      "playRuntimeAndVisualAcceptance": "separate_explicitly_approved_bounded_observation",
      "configurationDoesNotProveRuntime": true,
      "runtimeEvidenceDoesNotRewriteConfiguration": true
    },
    "perOutfitGate": {
      "scope": "actual_approved_change_and_affected_dependencies",
      "independentReadbackRequired": true
    },
    "replacementCleanup": {
      "legacyFxLayerDeletionByExactNameOnly": true,
      "legacySceneObjectRequiresCompleteInboundClosure": true,
      "deleteRequiresSeparateApproval": true,
      "neverDeleteSourceAvatarOrSourceAsset": true
    }
  },
  "steps": [
    {
      "name": "read_booth_asset_author_evidence_before_asset_change",
      "tool": "vrcforge_list_directory",
      "tools": ["vrcforge_find_files", "vrcforge_read_text_file"],
      "when": "an author asset, material, or texture is installed, replaced, adapted, or assigned, or its filename/folder carries a Booth/product number",
      "arguments": "locate the candidate Booth number and local author notes; require the host to provide readable product page and image evidence, classify each image role, and stop dependent writes when required page evidence is unavailable",
      "writes": false
    },
    {
      "name": "inspect_relevant_existing_evidence",
      "tool": "vrcforge_read_avatar_descriptor",
      "tools": [
        "vrcforge_list_avatars",
        "vrcforge_list_execution_targets",
        "vrcforge_bind_execution_target",
        "vrcforge_read_avatar_descriptor",
        "vrcforge_get_gameobject",
        "vrcforge_get_property",
        "vrcforge_scan_avatar_controls",
        "vrcforge_scan_parameters",
        "vrcforge_scan_fx_animator",
        "vrcforge_scan_animation_bindings",
        "vrcforge_scan_blendshapes",
        "vrcforge_get_runtime_observation"
      ],
      "writes": false,
      "boundedRecognitionLoop": true,
      "continueOnLocalUndetermined": true,
      "scanWardrobeIsOptionalClue": true,
      "confirmationRequiresFxAndClipEvidence": true,
      "missingFxStructureFieldsRemainUndetermined": [
        "entryExit",
        "blendTreeStructure",
        "drivers"
      ],
      "optional": true
    },
    {
      "name": "inspect_affected_scope",
      "tool": "vrcforge_list_avatars",
      "tools": [
        "vrcforge_list_execution_targets",
        "vrcforge_bind_execution_target",
        "vrcforge_read_avatar_descriptor",
        "vrcforge_get_gameobject",
        "vrcforge_scan_wardrobe",
        "vrcforge_scan_avatar_controls",
        "vrcforge_scan_parameters",
        "vrcforge_scan_fx_animator",
        "vrcforge_scan_animation_bindings",
        "vrcforge_scan_blendshapes",
        "vrcforge_scan_modular_avatar",
        "vrcforge_inspect_skinned_mesh_bone_usage"
      ],
      "writes": false,
      "optional": true
    },
    {
      "name": "inspect_animation_or_morph_evidence_when_relevant",
      "tool": "vrcforge_scan_animation_bindings",
      "tools": [
        "vrcforge_scan_blendshapes",
        "vrcforge_get_property",
        "vrcforge_inspect_skinned_mesh_deformation"
      ],
      "writes": false,
      "optional": true
    },
    {
      "name": "place_one_imported_outfit_instance_without_setup",
      "tool": "vrcforge_preview_add_outfit",
      "tools": ["vrcforge_add_outfit"],
      "guidance": "After importing the clothing asset, place one exact prefab instance under the target Avatar. For this placement-only pass use manageWardrobe=false, setupOutfit=false and unpackPrefab=false; do not fit, configure Setup Outfit or add wardrobe behavior in the same pass. If the outfit is already in the target scene, skip placement and inspect that existing object instead.",
      "writes": true,
      "conditional": "imported_outfit_prefab_is_not_yet_in_target_avatar_scene",
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "checkpointRequired": true,
      "optional": true
    },
    {
      "name": "read_prefab_unpack_preview_before_authoring_write",
      "tool": "vrcforge_preview_unpack_prefab",
      "guidance": "For a planned structural write to a scene Prefab instance, call this read-only tool with the bound executionTarget, constant projectPath, exact gameObjectPath and mode=completely. Verify the returned gameObjectPath, unpackMode, globalObjectId, prefabGuid, dependencyHash and scenePath match the target. Do not hand-guess expected identity guards.",
      "writes": false,
      "conditional": "newly_placed_or_existing_target_is_prefab_instance",
      "optional": true
    },
    {
      "name": "completely_unpack_prefab_instance_before_authoring",
      "tool": "vrcforge_unpack_prefab",
      "guidance": "After the read-only vrcforge_preview_unpack_prefab result matches the exact target, enter the normal formal approval preview and checkpoint flow; the write request preparer binds the verified identity guards. Do not pass preview=true to this write tool. After approval, run mode=completely, rebind the returned unpacked scene identity and require persisted readback before any other write. Preserve the source prefab asset and author Modular Avatar components, skeleton and animation references; ordinary material-property writes follow their own tool contract.",
      "writes": true,
      "conditional": "newly_placed_or_existing_target_is_prefab_instance",
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "checkpointRequired": true,
      "identityRebindRequired": true,
      "persistedReadbackRequired": true,
      "unpackMode": "completely",
      "optional": true
    },
    {
      "name": "setup_installed_outfit_after_prefab_unpack",
      "guidance": "Continue only after every newly placed or existing prefab instance has passed its preview, approved complete unpack, identity rebind and persisted readback gate. Preserve the imported object; do not reinstall it. Apply Setup Outfit and the approved wardrobe topology through their separate preview, approval, write and readback routes. Only an approved Int design may add a one-value Int skeleton; manageWardrobe=true requires an existing strict wardrobe scan record.",
      "tool": "vrcforge_preview_setup_outfit",
      "tools": [
        "vrcforge_setup_outfit",
        "vrcforge_preview_add_modular_avatar_component",
        "vrcforge_add_modular_avatar_component"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "optional": true
    },
    {
      "name": "edit_approved_parameters_or_fx",
      "guidance": "Create a skeleton only for an approved new scope where it is missing. A skeleton is not a strict verified wardrobe; never repeat creation because a strict scan is empty.",
      "tool": "vrcforge_preview_ensure_expression_parameter",
      "tools": [
        "vrcforge_ensure_expression_parameter",
        "vrcforge_preview_create_wardrobe",
        "vrcforge_create_wardrobe",
        "vrcforge_preview_manage_expression_parameters",
        "vrcforge_manage_expression_parameters",
        "vrcforge_preview_manage_fx_animator",
        "vrcforge_manage_fx_animator"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "optional": true
    },
    {
      "name": "edit_approved_wardrobe_mapping",
      "guidance": "add_wardrobe_outfit can add the first installed outfit to an existing Int/FX Equals skeleton using verified object paths and an explicit approved value. It preserves old clips: complete approved mutual-exclusion curves in all affected states, then fresh scan; recognition is not runtime acceptance.",
      "tool": "vrcforge_preview_manage_wardrobe",
      "tools": [
        "vrcforge_manage_wardrobe",
        "vrcforge_preview_add_wardrobe_outfit",
        "vrcforge_add_wardrobe_outfit"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "optional": true
    },
    {
      "name": "edit_only_approved_animation_differences",
      "tool": "vrcforge_preview_write_animation_curve",
      "tools": [
        "vrcforge_write_animation_curve",
        "vrcforge_preview_ensure_animator_state",
        "vrcforge_ensure_animator_state",
        "vrcforge_preview_manage_fx_animator",
        "vrcforge_manage_fx_animator"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "optional": true
    },
    {
      "name": "refit_only_with_evidence_and_approval",
      "tool": "vrcforge_get_property",
      "tools": [
        "vrcforge_set_property",
        "vrcforge_inspect_skinned_mesh_deformation"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "conditional": "head_or_neck_transplant_or_fit_target_mismatch_or_visual_offset_or_penetration",
      "optional": true
    },
    {
      "name": "edit_approved_menu_controls",
      "tool": "vrcforge_preview_ensure_expression_menu_control",
      "tools": [
        "vrcforge_ensure_expression_menu_control",
        "vrcforge_preview_manage_expression_menu",
        "vrcforge_manage_expression_menu"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "optional": true
    },
    {
      "name": "start_user_approved_bounded_runtime_observation_after_gm_ready",
      "tool": "vrcforge_gesture_manager_enter_play_mode",
      "tools": [
        "vrcforge_gesture_manager_set_parameter",
        "vrcforge_start_runtime_observation"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "conditional": "user_approved_runtime_plan_and_exact_identity_and_gm_ready",
      "optional": true
    },
    {
      "name": "read_relevant_results_and_runtime_evidence",
      "tool": "vrcforge_scan_wardrobe",
      "tools": [
        "vrcforge_scan_avatar_controls",
        "vrcforge_scan_parameters",
        "vrcforge_scan_fx_animator",
        "vrcforge_scan_animation_bindings",
        "vrcforge_scan_blendshapes",
        "vrcforge_inspect_skinned_mesh_deformation",
        "vrcforge_get_runtime_observation",
        "vrcforge_gesture_manager_status",
        "vrcforge_run_validation_report",
        "vrcforge_build_test_readiness"
      ],
      "writes": false,
      "optional": true
    },
    {
      "name": "restore_user_approved_play_state_after_runtime_observation",
      "tool": "vrcforge_set_play_mode",
      "tools": [
        "vrcforge_gesture_manager_status"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "conditional": "workflow_owned_play_change_or_explicit_user_play_target",
      "optional": true
    },
    {
      "name": "cleanup_exact_authorized_targets",
      "tool": "vrcforge_scan_inbound_reference_closure",
      "tools": [
        "vrcforge_preview_manage_fx_animator",
        "vrcforge_manage_fx_animator",
        "vrcforge_set_gameobject_active",
        "vrcforge_delete_gameobject",
        "vrcforge_scan_fx_animator",
        "vrcforge_get_gameobject"
      ],
      "writes": true,
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true,
      "conditional": "user_explicitly_requested_replacement_cleanup_and_reference_closure_is_complete",
      "optional": true
    }
  ],
  "approval": {
    "required": true,
    "owner": "runtime_supervision_layer",
    "scope": "one_exact_preview_bound_write_through_current_permission_policy"
  },
  "checkpoint": {
    "required": true,
    "boundaries": [
      "before_each_approved_write"
    ]
  },
  "rollback": {
    "required": true,
    "requiresSeparateApproval": true
  },
  "selectionPolicy": {
    "kind": "capability_catalog_not_mandatory_sequence",
    "scope": "user_request_and_observed_evidence",
    "expectedBehavior": "observed_evidence_and_explicit_user_approved_changes",
    "presetProjectDesign": false
  }
}
