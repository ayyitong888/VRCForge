{
  "schema": "vrcforge.skill-package.workflow.v1",
  "mode": "approval_required",
  "selfContained": true,
  "requiresOtherSkills": [],
  "scope": ["outfit_mount", "wardrobe", "expression_parameters", "fx_animator", "animation_curves", "expression_menu", "runtime_acceptance"],
  "uncertaintyPolicy": {"whenUnclear": ["skeleton", "modular_avatar", "wardrobe", "expression_menu", "parameters", "fx_animator", "animation", "asset_license"], "consult": ["mature_community_guides", "asset_author_instructions", "official_documentation"], "onInsufficientEvidence": {"capabilityGap": true, "ready": false, "action": "stop_and_report"}, "mustNot": ["guess", "invent_tools", "claim_unverified_support", "use_unauthorized_assets"]},
  "communityWardrobeContract": {
    "outfitAttachment": "ModularAvatarSetupOutfit",
    "requiredSetupResult": "ModularAvatarMergeArmature",
    "selector": {"name": "衣柜", "type": "Int", "saved": true, "synced": true, "default": 0, "preserveExistingValuesAndAliases": true},
    "fx": {"transitionSource": "AnyState", "condition": "衣柜 == selected_value", "durationSeconds": 0, "hasExitTime": false, "writeDefaults": true},
    "animation": {"keyframeTimeSeconds": 0, "inspectExactEnableDisableAndUnchangedSets": true, "preserveBodyBlendShapesUnlessProven": true},
    "menu": {"rootOrder": ["FacialTracking", "换装", "R18"], "category": "衣服", "maximumControlsPerPageIncludingNextPage": 8, "pageLabel": "下一页", "preserveIconsLabelsLanguagesAndExistingAliases": true},
    "assetBoundary": {"authorizedAssetsOnly": true, "preserveVendorPhysBonesConstraintsAndColliders": true, "neverDeleteSourceAvatar": true}
  },
  "steps": [
    {"name": "inventory_descriptor_wardrobe_parameter_fx_menu_and_animation", "tool": "vrcforge_list_avatars", "tools": ["vrcforge_read_avatar_descriptor", "vrcforge_scan_wardrobe", "vrcforge_scan_avatar_controls", "vrcforge_scan_parameters", "vrcforge_scan_fx_animator", "vrcforge_scan_animation_bindings"], "writes": false},
    {"name": "verify_outfit_weighted_bones_and_modular_avatar_setup", "tool": "vrcforge_inspect_skinned_mesh_bone_usage", "tools": ["vrcforge_scan_modular_avatar", "vrcforge_preview_setup_outfit", "vrcforge_setup_outfit"], "writes": true, "runtimePermissionGateRequired": true, "runtimeApprovalRequired": true},
    {"name": "create_or_extend_exact_saved_synced_wardrobe_int", "tool": "vrcforge_preview_ensure_expression_parameter", "tools": ["vrcforge_ensure_expression_parameter", "vrcforge_preview_create_wardrobe", "vrcforge_create_wardrobe", "vrcforge_preview_add_wardrobe_outfit", "vrcforge_add_wardrobe_outfit"], "writes": true, "runtimePermissionGateRequired": true, "runtimeApprovalRequired": true},
    {"name": "author_matching_fx_state_transition_and_outfit_clip", "tool": "vrcforge_preview_ensure_animator_state", "tools": ["vrcforge_ensure_animator_state", "vrcforge_preview_manage_fx_animator", "vrcforge_manage_fx_animator", "vrcforge_preview_write_animation_curve", "vrcforge_write_animation_curve"], "writes": true, "runtimePermissionGateRequired": true, "runtimeApprovalRequired": true},
    {"name": "add_exact_wardrobe_menu_control_without_duplicate", "tool": "vrcforge_preview_ensure_expression_menu_control", "tools": ["vrcforge_ensure_expression_menu_control", "vrcforge_preview_manage_expression_menu", "vrcforge_manage_expression_menu"], "writes": true, "runtimePermissionGateRequired": true, "runtimeApprovalRequired": true},
    {"name": "read_back_entire_menu_parameter_fx_animation_object_chain", "tool": "vrcforge_scan_wardrobe", "tools": ["vrcforge_scan_avatar_controls", "vrcforge_scan_parameters", "vrcforge_scan_fx_animator", "vrcforge_scan_animation_bindings", "vrcforge_run_validation_report", "vrcforge_build_test_readiness"], "writes": false}
  ],
  "approval": {"required": true, "owner": "runtime_supervision_layer", "scope": "one_exact_write_through_current_permission_policy"},
  "checkpoint": {"required": true, "boundaries": ["before_outfit_install", "before_wardrobe_parameter_change", "before_fx_animation_change", "before_menu_change"]},
  "rollback": {"required": true, "requiresSeparateApproval": true}
}
