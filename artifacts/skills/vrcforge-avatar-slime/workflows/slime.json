{
  "schema": "vrcforge.skill-package.workflow.v1",
  "mode": "approval_required",
  "selfContained": true,
  "requiresOtherSkills": [],
  "guidanceFiles": [
    "references/workflow.md",
    "references/parameter-tuning.md",
    "references/surface-and-transition.md"
  ],
  "scope": [
    "translucent_slime_surface",
    "lightweight_ripple_normal",
    "normal_slime_transition",
    "head_hair_tail_layering",
    "visual_runtime_acceptance"
  ],
  "selectionPolicy": {
    "presetAvatarPaths": false,
    "presetColor": false,
    "presetRenderQueue": false,
    "presetMenuPath": false,
    "reuseExistingTools": true
  },
  "uncertaintyPolicy": {
    "consult": [
      "mature_community_guides",
      "asset_author_instructions",
      "official_documentation"
    ],
    "onInsufficientEvidence": {
      "action": "read_missing_relevant_data_then_report_exact_remaining_gap_continue_independent_work"
    }
  },
  "steps": [
    {
      "name": "inspect_current_avatar_and_materials",
      "tool": "vrcforge_scan_materials",
      "tools": [
        "vrcforge_list_avatars",
        "vrcforge_bind_execution_target",
        "vrcforge_get_gameobject"
      ],
      "writes": false,
      "optional": true,
      "guide": {
        "file": "references/workflow.md",
        "step": 1
      }
    },
    {
      "name": "inspect_shader_capabilities_and_write_route",
      "tool": "vrcforge_inspect_material_properties",
      "tools": [
        "vrcforge_get_asset_info",
        "vrcforge_preview_material_shader_assignment",
        "vrcforge_preview_shader_apply",
        "vrcforge_plan_shader_tuning"
      ],
      "writes": false,
      "optional": true,
      "guide": {
        "file": "references/workflow.md",
        "step": 2
      }
    },
    {
      "name": "prepare_independent_materials_and_textures",
      "tool": "vrcforge_preview_project_asset_duplicate",
      "tools": [
        "vrcforge_find_assets",
        "vrcforge_duplicate_project_asset",
        "vrcforge_set_material_shader",
        "vrcforge_preview_renderer_material_slot",
        "vrcforge_set_renderer_material_slot",
        "vrcforge_preview_material_texture_assignment",
        "vrcforge_set_material_texture",
        "vrcforge_preview_texture_import_settings",
        "vrcforge_set_texture_import_settings"
      ],
      "writes": true,
      "optional": true,
      "guide": {
        "file": "references/workflow.md",
        "step": 3
      },
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true
    },
    {
      "name": "tune_static_surface_and_parts",
      "tool": "vrcforge_preview_material_shader_assignment",
      "tools": [
        "vrcforge_set_material_shader",
        "vrcforge_preview_shader_apply",
        "vrcforge_apply_shader_tuning",
        "vrcforge_texture_patch"
      ],
      "writes": true,
      "optional": true,
      "guide": {
        "file": "references/workflow.md",
        "step": 4
      },
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true
    },
    {
      "name": "author_independent_ripple_animation",
      "tool": "vrcforge_scan_animation_bindings",
      "tools": [
        "vrcforge_preview_material_texture_assignment",
        "vrcforge_set_material_texture",
        "vrcforge_preview_write_animation_curve",
        "vrcforge_write_animation_curve"
      ],
      "writes": true,
      "optional": true,
      "guide": {
        "file": "references/workflow.md",
        "step": 5
      },
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true
    },
    {
      "name": "author_normal_slime_toggle_and_transition",
      "tool": "vrcforge_scan_modular_avatar",
      "tools": [
        "vrcforge_inspect_modular_avatar_component",
        "vrcforge_scan_parameters",
        "vrcforge_scan_fx_animator",
        "vrcforge_preview_add_modular_avatar_component",
        "vrcforge_add_modular_avatar_component",
        "vrcforge_preview_manage_expression_parameters",
        "vrcforge_manage_expression_parameters",
        "vrcforge_preview_manage_expression_menu",
        "vrcforge_manage_expression_menu",
        "vrcforge_preview_manage_fx_animator",
        "vrcforge_manage_fx_animator",
        "vrcforge_preview_write_animation_curve",
        "vrcforge_write_animation_curve"
      ],
      "writes": true,
      "optional": true,
      "guide": {
        "file": "references/workflow.md",
        "step": 6
      },
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true
    },
    {
      "name": "diagnose_layers_and_test_interior_visibility",
      "tool": "vrcforge_inspect_material_properties",
      "tools": [
        "vrcforge_get_property",
        "vrcforge_set_property",
        "vrcforge_preview_scene_object_duplicate",
        "vrcforge_duplicate_scene_object",
        "vrcforge_set_gameobject_active",
        "vrcforge_capture_screenshot"
      ],
      "writes": true,
      "optional": true,
      "guide": {
        "file": "references/workflow.md",
        "step": 7
      },
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true
    },
    {
      "name": "observe_runtime_save_and_read_relevant_reports",
      "tool": "vrcforge_gesture_manager_status",
      "tools": [
        "vrcforge_gesture_manager_enter_play_mode",
        "vrcforge_gesture_manager_set_parameter",
        "vrcforge_start_runtime_observation",
        "vrcforge_get_runtime_observation",
        "vrcforge_capture_screenshot",
        "vrcforge_capture_multi_screenshot",
        "vrcforge_set_play_mode",
        "vrcforge_preview_save_asset",
        "vrcforge_save_asset",
        "vrcforge_scene_save",
        "vrcforge_get_compile_errors",
        "vrcforge_get_ndmf_errors",
        "vrcforge_read_vrchat_sdk_builder_alerts",
        "vrcforge_preview_diagnostic_fix",
        "vrcforge_apply_diagnostic_fix"
      ],
      "writes": true,
      "optional": true,
      "guide": {
        "file": "references/workflow.md",
        "step": 8
      },
      "runtimePermissionGateRequired": true,
      "runtimeApprovalRequired": true
    },
    {
      "name": "compare_performance_and_deliver_actual_images",
      "tool": "vrcforge_scan_avatar_performance",
      "tools": [
        "vrcforge_run_validation_report"
      ],
      "writes": false,
      "optional": true,
      "guide": {
        "file": "references/workflow.md",
        "step": 9
      }
    }
  ],
  "approval": {
    "required": true,
    "owner": "runtime_supervision_layer",
    "scope": "current_user_authorized_change_no_duplicate_confirmation"
  },
  "checkpoint": {
    "required": true,
    "reuseExistingMechanism": true
  },
  "rollback": {
    "requiresSeparateApproval": true
  },
  "evidence": {
    "storedAssetIsRuntimeProof": false,
    "callbackReturnIsFixProof": false,
    "noReportMeansNoErrors": false,
    "userVisibleImagesRequired": true,
    "clientAcceptanceSeparate": true
  }
}

