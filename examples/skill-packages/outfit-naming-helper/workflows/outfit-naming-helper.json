{
  "schema": "vrcforge.skill-package.workflow.v1",
  "mode": "approval_required",
  "steps": [
    {
      "name": "request_atomic_reference_rename",
      "tool": "vrcforge_request_apply",
      "writes": true,
      "request": {
        "targetTool": "vrcforge_unity_mcp_write",
        "scanTool": "vrcforge_scan_animation_bindings",
        "previewTool": "vrcforge_preview_atomic_reference_rename",
        "oneOperationPerExecution": true,
        "argumentsByOperation": {
          "game_object": {
            "projectPath": "$projectPath",
            "toolName": "vrc_atomic_reference_rename",
            "arguments": {
              "operationKind": "game_object",
              "scenePath": "$scenePath",
              "avatarPath": "$avatarPath",
              "targetObjectPath": "$targetObjectPath",
              "newName": "$newName"
            }
          },
          "parameter": {
            "projectPath": "$projectPath",
            "toolName": "vrc_atomic_reference_rename",
            "arguments": {
              "operationKind": "parameter",
              "scenePath": "$scenePath",
              "avatarPath": "$avatarPath",
              "oldParameterName": "$oldParameterName",
              "newParameterName": "$newParameterName"
            }
          }
        }
      }
    }
  ],
  "approval": {
    "required": true,
    "reason": "The selected operation migrates Unity object or parameter references and must remain bound to the reviewed preview."
  },
  "checkpoint": {
    "required": true,
    "scope": [
      "Assets",
      "Packages",
      "ProjectSettings"
    ]
  },
  "rollback": {
    "required": true,
    "tool": "vrcforge_restore_checkpoint",
    "requiresSeparateApproval": true,
    "reason": "Restore the pre-write checkpoint only through a separate supervised approval."
  }
}
