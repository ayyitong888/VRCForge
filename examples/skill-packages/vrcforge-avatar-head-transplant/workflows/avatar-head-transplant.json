{
  "schema": "vrcforge.skill-package.workflow.v1",
  "mode": "approval_required",
  "uncertaintyPolicy": {
    "whenUnclear": ["skeleton", "neck_seam", "material", "accessory", "physbone", "modular_avatar", "vrcfury"],
    "consult": ["mature_community_guides", "asset_author_instructions", "official_documentation"],
    "onInsufficientEvidence": {"capabilityGap": true, "ready": false, "action": "stop_and_report"},
    "mustNot": ["guess", "invent_tools", "claim_unverified_support"]
  },
  "requires": {
    "minVRCForgeVersion": "1.7.9",
    "capabilities": [
      "capture_screenshot.angle.bottom",
      "causal_result_contract.v1",
      "inspect_skinned_mesh_deformation.v1"
    ],
    "onMissing": "blocked_not_ready"
  },
  "capabilityGapContract": {
    "missingFields": ["capabilityGap", "needsDccRerig"],
    "onMissing": "blocked_not_ready",
    "mustNotClaim": "ready_or_pass",
    "freeCameraFields": ["angle", "rotation", "scope", "returnedRotation", "unobstructed", "evidence"]
  },
  "communityAvatarModificationContract": {
    "source": "user_supplied_avatar_mod_rules",
    "precedence": "when selected this matrix and visual policy overrides generic matrix_bindpose_neck_ring diagnostic gates unless separately authorized",
    "matrixPolicy": {"default": "prohibited", "requiresSeparateExplicitUserAuthorization": true, "forbiddenByDefault": ["skin_matrix_analysis", "determinant_checks", "bindpose_comparison", "programmatic_transform_guessing", "sub_millimeter_vertex_comparison"], "neverCountsTowardVisualAcceptance": true, "authorizedDiagnosticsRemainDiagnosticOnly": true},
    "visibleCandidateTimebox": {"minutesPerStep": 20, "onNoVisibleCandidate": "stop_report_current_state_with_screenshot_and_ask_for_direction", "mustNot": "continue_exploring_after_timebox"},
    "visualAcceptance": {"authority": "free_camera_pixels_at_normal_vrchat_viewing_distance", "normalViewingDistanceMeters": [1.0, 2.0], "failIf": ["visible_gap", "floating_geometry", "visible_distortion"], "matrixNormalMapOrSubMillimeterEvidenceCannotPass": true, "remoteScreenshotWithoutVerifiedCameraEvidenceCannotPass": true},
    "headSwap": {
      "classification": "full_head_transplant_not_rigid_or_independent_accessory_or_clothing_part_route",
      "mergeArmatureScope": "full_head_community_route_only_does_not_authorize_setup_outfit_for_rigid_or_independent_accessories",
      "method": "unity_first_modular_avatar_merge_armature_replace_object_and_layered_neck_seam_resolution",
      "steps": ["match_overall_head_body_scale_in_unity", "place_head_prefab_under_target_avatar", "ma_setup_outfit_then_merge_armature", "match_bone_names_to_integration_target_when_needed", "ma_replace_object_head_face_reference_to_target_old_face_path", "mark_original_target_head_face_mesh_editor_only", "inspect_visible_neck_geometry_and_attachment_motion_without_hair_or_collar", "preserve_user_selected_body_material_and_texture", "match_shader_probe_anchor_and_shadow_lighting", "identify_exact_visible_head_renderer_material_slot_and_neck_uv_region", "assign_only_approved_preauthored_head_local_seam_texture_when_required", "reconfigure_eye_bone_lipsync_visemes_eyelids_and_viewpoint", "repair_fx_animation_paths", "verify_active_renderer_consumer_closure"],
      "visualAcceptance": {"poses": ["Rest", "AFK"], "minimumViews": ["front", "back", "side_left", "side_right"], "sameFramingPairs": true, "pass": "no_visible_neck_gap_floating_geometry_or_abrupt_skin_color_step", "onFail": "classify_geometry_weight_lighting_or_local_texture_failure_and_fix_only_that_layer"},
      "legacyConcealmentRequiresExplicitUserChoice": ["verified_head_mesh_overlap", "mesh_hole_shrinker", "color_matched_primitive"],
      "forbidden": ["csharp_mesh_vertex_manipulation", "programmatic_neck_ring_diameter_matching", "camera_occlusion_as_acceptance"],
      "capabilityBoundary": {"maSetupOutfitAndMergeArmature": "vrcforge_supported_preview_and_write_atoms", "maReplaceObject": "manual_or_capability_gap_when_no_exact_atom", "meshHoleShrinker": "external_manual_or_capability_gap", "localTextureAuthoring": "external_manual_or_capability_gap_when_no_exact_atom", "existingTextureAssignment": "vrcforge_preview_material_texture_assignment_then_approved_vrcforge_set_material_texture"}
    }
  },
  "neckSeamResolutionContract": {
    "defaultRoute": "unity_first_modular_avatar_head_swap",
    "dccFallbackOnlyWhen": ["actual_neck_mesh_aperture_cannot_fit", "donor_specific_weights_cannot_be_reconciled"],
    "classifyInOrder": ["visible_geometry", "pose_dependent_weights", "lighting_and_shader", "renderer_slot_ownership", "localized_head_texture"],
    "bodyBaseline": {
      "source": "the user's actual currently assigned target body renderer material and textures",
      "mustPreserve": ["material_asset", "main_texture", "masks", "body_details", "body_armature_scale"],
      "mustNotSubstitute": ["assumed_official_default", "third_party_body_texture", "historically_rejected_body_candidate"]
    },
    "unityMaterialSteps": ["load_materials_tool_block", "scan_exact_head_and_body_materials", "identify_visible_renderer_slot", "match_shader_and_probe_anchor", "optionally_duplicate_target_compatible_material_and_retain_donor_face_texture", "plan_minimal_shadow_and_lighting_changes", "approve_each_exact_material_write", "capture_same_camera_light_on_and_off"],
    "localizedTexture": {
      "allowedTarget": "approved generated copy of the exact visible head-face material texture",
      "mask": "only the visible neck interface or front-jaw UV islands confirmed from the actual mesh",
      "sampling": "actual current body appearance compensated for target head material tint and lighting",
      "protect": ["target_body_texture", "mouth", "nose", "eyes", "heterochromia", "alpha", "pixels_outside_exact_uv_mask"],
      "authoringAtomAvailable": false,
      "onMissingAuthoringAtom": {"capabilityGap": true, "ready": false, "failureCause": "seam_authoring_atom_unavailable", "nextAction": "user_owned_external_texture_authoring_then_approved_unity_texture_assignment"},
      "materialTemplateAtoms": ["vrcforge_preview_project_asset_duplicate", "vrcforge_duplicate_project_asset"],
      "assignmentAtoms": ["vrcforge_preview_material_texture_assignment", "vrcforge_set_material_texture"]
    },
    "fallbackConcealment": "only when the user explicitly accepts a collar, overlap, primitive, or external hole-shrinker; never claim an actual seam repair",
    "acceptance": ["hair_and_collar_hidden_for_interface_inspection", "front_left_right_back_same_camera", "rest_afk_head_down_and_turns", "body_material_unchanged", "no_visible_gap_or_abrupt_skin_color_step"]
  },
  "transplantModes": [
    {"id": "rigid", "steps": ["inventory", "inactive_stage", "local_fit", "readback"]},
    {"id": "same_skeleton_smr", "steps": ["non_zero_weights", "target_compatible_armature_merge_or_explicit_used_bone_remap", "bones_rootBone_bindposes", "index_count_parity", "dynamic_sweep"]},
    {"id": "foreign_skeleton_smr", "steps": ["minimal_weighted_chain", "armature_merge_or_explicit_used_bone_map", "reject_mixed_unresolved_chain", "deformation_readback"]},
    {"id": "independent_skeleton_physbone", "steps": ["whole_prefab_and_complete_bounded_root_to_tip_chain", "create_distinct_installContainer_and_swayChainRoot", "cat_ear_ma_bone_proxy_target_Head_or_direct_mount_equivalent", "uniform_scale_installContainer_only", "keep_swayChainRoot_and_every_descendant_bone_Rest_localScale_one", "close_physbone_root_collider_probe_constraint_contact_and_all_external_references", "renderer_used_bone_closure", "same_framing_close_root_Rest_AFK_multiview_then_head_down_head_turn_aabb_skin_matrix_sweep"]},
    {"id": "animator_menu", "steps": ["inbound_consumers", "exact_path_parameter_remap", "retain_target_controls", "menu_parameter_acceptance"]}
  ],
  "sizeMismatchPriority": ["measure_attachment_space", "first_fit_imported_whole_head_or_accessory_installContainer_with_uniform_scale_and_position_in_unity", "keep_swayChainRoot_and_every_descendant_bone_Rest_localScale_one", "diagnose_used_bone_bindpose_and_skin_matrix_metrics", "needsDccRerig_only_for_real_neck_aperture_mesh_shape_or_donor_specific_weights", "never_scale_target_body_or_armature"],
  "skinningContract": {
    "required": ["renderer.bones", "renderer.rootBone", "renderer.bindposes", "allUsedBonesResolved", "allUsedBindposesResolved", "noOutOfRangeWeights", "mixedChainClosure", "safeForWeightedRemap"],
    "informational": ["nullBoneCount", "unusedBoundBoneCount"],
    "rejectIf": ["truncated_scan", "unresolved_used_bone", "unresolved_used_bindpose", "no_out_of_range_weights_false", "mixed_chain_closure_false", "safe_for_weighted_remap_false"],
    "communityRouteOverride": "reference_and_count_closure_only_matrix_value_and_bindpose_comparison_require_separate_authorization"
  },
  "geometryAlignmentContract": {
    "required": ["attachmentFrame", "neckRingCenter", "neckRingNormal", "neckRingRadius", "pivot", "boneRoll"],
    "measureIn": "target_neck_rest_frame",
    "order": ["measure_source_and_target", "align_center_and_normal", "fit_uniform_local_scale", "check_gap_and_overlap"],
    "allowedMutation": "imported_part_local_transform_only",
    "forbidden": ["scale_target_body_or_armature", "occlusion_as_geometry_fix", "bulk_remesh_when_blendshapes_must_survive"],
    "onUnreconciled": {"needsDccRerig": true, "ready": false, "failureCauseRequired": true},
    "communityHeadRouteOverride": "unity_first_visible_geometry_lighting_and_local_texture_repair_overlap_requires_explicit_user_acceptance"
  },
  "rigAndShapeContract": {
    "required": ["targetRestPose", "boneRollReadback", "bindposeReadback", "localWeightTransfer", "blendShapeOrder", "arkitNames"],
    "bindpose": "diagnose_and_prove_target_rest_inverse_bind_matrices; raw_matrix_editing_is_not_a_routine_unity_user_step; use_weighted_remap_or_dcc_rerig_when_unreconciled",
    "weights": "transfer_only_minimal_used_chain; normalize_non_zero_weights; bulk_remap_forbidden",
    "blendShapes": "preserve_basis_vertex_order_and_all_source_shape_keys; arkit_names_exact",
    "onFailure": {"needsDccRerig": true, "ready": false, "failureCauseRequired": true, "mustNotClaim": "Build_success"},
    "communityRouteOverride": "skip_bindpose_matrix_analysis_and_programmatic_weight_vertex_manipulation_unless_separately_authorized"
  },
  "physboneAbContract": {
    "required": ["enabledBefore", "rootTransform", "bonePath", "colliderAndProbeReferences", "colliderReferences", "probeAnchorReferences", "constraintSourceReferences", "contactReferences", "allExternalObjectReferences", "enabledAfter"],
    "isolation": ["record_state", "disable_A_and_B_temporarily", "capture_rest_and_dynamic", "restore_state", "readback_restoration"],
    "restoreFailure": {"ready": false, "failureCause": "physbone_baseline_restore_failed"}
  },
  "catEarDeformationDiagnosticsContract": {
    "route": "independent_skeleton_physbone",
    "attachment": {
      "targetBone": "Head",
      "maBoneProxyTarget": "Head",
      "directMountEquivalent": "installContainer_parent_is_target_avatar_Head",
      "installContainer": {
        "role": "whole_accessory_uniform_fit_and_head_attachment",
        "uniformLocalScaleAllowed": true,
        "requiredReadback": ["parentOrProxyTarget", "localPosition", "localRotation", "uniformLocalScale"]
      },
      "swayChainRoot": {
        "mustBeDistinctFromInstallContainer": true,
        "localScale": [1.0, 1.0, 1.0],
        "descendantBoneRestLocalScale": [1.0, 1.0, 1.0],
        "requireEveryDescendantBoneRestScaleOne": true,
        "preserveInternalLocalTrs": true
      },
      "rootLocalScale": [1.0, 1.0, 1.0],
      "rootLocalScaleMeaning": "swayChainRoot_rest_scale_not_installContainer_scale",
      "requiredReadback": ["completeBoundedBoneChain", "targetAttachmentBone", "rootLocalScale", "installContainer", "swayChainRoot", "descendantBoneRestLocalScales", "physBoneRootTransform", "consumedColliderReferences", "physBoneColliderReferences", "probeAnchorReferences", "constraintSourceReferences", "contactReferences", "allExternalObjectReferences"]
    },
    "externalReferenceClosure": {
      "required": ["physBoneRootTransform", "physBoneColliderReferences", "probeAnchorReferences", "constraintSourceReferences", "contactReferences", "allExternalObjectReferences"],
      "allowedRoots": ["copiedAccessoryBranch", "targetAvatarHierarchy"],
      "sourceAvatarReferencesRemaining": 0,
      "unresolvedReferences": 0,
      "scanMustBeCompleteAndNonTruncated": true
    },
    "tool": "vrcforge_inspect_skinned_mesh_deformation",
    "diagnosticOnly": true,
    "requiresSeparateExplicitUserAuthorization": true,
    "defaultCommunityRoute": "do_not_run_matrix_determinant_or_bindpose_analysis",
    "countsTowardVisualAcceptance": false,
    "restRequired": ["rest.vertexCount", "rest.finiteVertexCount", "rest.aabb", "play.vertexCount", "play.finiteVertexCount", "world.aabb", "world.distanceSummary", "usedBoneReconstructedSkinMatrix"],
    "skinMatrixMetrics": ["sampleCount", "maxTranslationMagnitude", "maxAbsDeviation", "determinantMin", "determinantMax"],
    "restSkinMatrixGate": {"enabledOnlyWhenSeparatelyAuthorized": true, "maxAbsDeviation": 0.001, "determinantRange": [0.999, 1.001], "unless": "source_fbx_rest_baseline_proves_a_different_finite_value"},
    "perPose": ["Rest", "AFK", "HeadDown", "HeadTurnLeft", "HeadTurnRight"],
    "perPoseRequired": ["allVerticesFinite", "worldAabb", "distanceP95AndMax", "skinMatrixMetrics", "sameCloseRootFiveViewPixels"],
    "comparisonBaseline": "accepted_rest_and_same_pose_source_or_pre_migration_metrics",
    "sameCameraRestMotionPairs": true,
    "sameFramingRestAfkMultiViewPairs": true,
    "failIf": ["finite_vertex_count_changes", "aabb_inflates_collapses_or_translates_beyond_declared_baseline_tolerance", "skin_matrix_scale_or_translation_jumps_beyond_declared_baseline_tolerance", "ear_root_shifts_from_head", "ear_root_gap_or_seam_changes_size_between_poses", "ear_size_or_attachment_changes_between_rest_and_motion"],
    "views": ["front", "side_left", "side_right", "back", "bottom"],
    "unobstructedCloseRootView": true
  },
  "poseSweep": ["Rest", "AFK", "Upright", "VelocityZ", "AngularY", "body-size-min", "body-size-max", "face-tracking-min", "face-tracking-max"],
  "pitfallMatrix": [
    {"symptom": "floating_or_exploding_mesh", "rootCause": "wrong_parent_or_bindpose_or_mixed_chain", "check": "weights_bones_rootBone_bindposes", "forbidden": "scale_target_body_or_accept_build", "reversibleFix": "disable_staged_copy_restore_checkpoint_remap_chain", "dynamicAcceptance": "full_pose_sweep_no_detachment"},
    {"symptom": "motion_only_neck_seam", "rootCause": "duplicate_neck_head_inheritance", "check": "neck_weighted_target_during_motion", "forbidden": "front_only_or_unnamed_capture", "reversibleFix": "retain_old_head_reparent_rebind", "dynamicAcceptance": "five_views_rest_and_motion"},
    {"symptom": "physbone_jump_or_inert_collider", "rootCause": "donor_root_collider_probe_closure", "check": "component_target_readback", "forbidden": "copy_component_without_consumers", "reversibleFix": "disable_staged_branch_rebind_target_refs", "dynamicAcceptance": "velocityz_angulary_collision_sweep"},
    {"symptom": "face_or_menu_silent", "rootCause": "partial_mesh_fx_parameters_menu_contract", "check": "four_consumers_and_build_projection", "forbidden": "copy_one_asset_or_source_counts", "reversibleFix": "restore_checkpoint_remap_paths_parameters", "dynamicAcceptance": "face_extremes_and_gesture_fallback"},
    {"symptom": "empty_scan_with_references", "rootCause": "truncated_or_unavailable_capability", "check": "ready_blockers_capability_gap_dcc_rerig", "forbidden": "treat_zero_as_closure", "reversibleFix": "stop_before_write_request_atom_or_dcc_rerig", "dynamicAcceptance": "ready_false_no_fake_pass"}
  ],
  "buildProjection": {"order": ["visual_and_motion_acceptance", "build_test_readiness", "build_test_avatar"], "buildCannotOverride": ["visible_seam", "missing_dynamic_control", "capabilityGap"]},
  "failureEtiologyFields": ["success", "status", "error", "failedStep", "diagnostics", "failureLayer", "failurePhase", "failureCause", "rootCause", "causeChain", "observed", "expected", "delta", "blockingReasons", "capabilityGap", "needsDccRerig", "mutationStarted", "committed", "commitState", "sceneSaved", "persistedReadback", "evidence", "recovery", "nextAction"],
  "singleSlotRemapContract": {
    "capability": "vrcforge_remap_skinned_mesh_bone",
    "order": ["inspectUsedBoneIndices", "readRestSkinningDelta", "previewOneSlot", "comparePredictedSkinningMetrics", "approvedExecuteOneSlot", "readbackBonesRootBoneBindposes"],
    "bulkRemap": "forbidden",
    "predictedMetricGate": {
      "required": ["current", "target", "donorChainBaseline"],
      "compare": ["translationMagnitude", "maxAbsDeviation", "nearIdentity", "mixedChainClosure"],
      "executeOnlyWhen": "target is materially closer to donorChainBaseline than current and allUsedBonesResolved/allUsedBindposesResolved/noOutOfRangeWeights/mixedChainClosure/safeForWeightedRemap remain true",
      "otherwise": {"needsDccRerig": true, "ready": false, "capabilityGap": false}
    },
    "onMissing": {"capabilityGap": true, "ready": false, "needsDccRerig": "when_no_paired_morph_or_bindpose_reconciliation"},
    "communityRouteOverride": "no_predicted_skin_matrix_comparison_or_remap_by_default_requires_separate_authorization"
  },
  "dynamicAcceptance": {
    "poses": ["Rest", "AFK", "Upright", "VelocityZ", "AngularY"],
    "optionalExtremes": ["body-size-min", "body-size-max", "face-tracking-min", "face-tracking-max"],
    "views": ["front", "side_left", "side_right", "back", "bottom"],
    "unobstructed": true,
    "cameraEvidence": ["position", "target", "basis", "quaternion", "projection", "matrix"],
    "orthogonalBasis": true,
    "obliqueAuxiliaryViewsAllowed": true,
    "obliqueAuxiliaryViewsCountTowardsAcceptance": false,
    "thresholds": ["returnedRotationMatchesRequest", "artifactNonEmpty", "noCropOrOccluder", "restoreBaselineParameters"],
    "baselineContract": {"recordBeforePoseSweep": true, "readBackAfterEachPose": true, "restoreAfterSweep": true, "blockIfRestoreReadbackFails": true}
  },
  "atomicCompositionResultContract": {
    "stopOnFailedStep": true,
    "failedStepRequiredOnFailure": true,
    "surfaces": ["internal_agent_loop", "external_mcp_agent"],
    "surfaceParityRequired": true,
    "preserveEachStep": ["step", "tool", "result", "success", "status", "ready", "error", "failureCause", "rootCause", "causeChain", "failedStep", "diagnostics"],
    "preserveNestedResultUnchanged": true,
    "failureDiagnosisRequired": {
      "required": ["success", "status", "failedStep"],
      "atLeastOneOf": ["error", "failureCause", "rootCause", "causeChain", "diagnostics"],
      "onMissing": "block_and_report_contract_failure"
    },
    "mustNot": ["collapse_tool_error_to_false", "drop_failed_step", "drop_handler_diagnostics", "replace_specific_cause_with_generic_failure", "continue_after_failed_write"]
  },
  "causeContract": {
    "callAndDomainStatusAreIndependent": true,
    "alwaysRequired": [
      "success",
      "status"
    ],
    "preserveWhenPresent": [
      "error",
      "failedStep",
      "diagnostics",
      "ready",
      "blockingReasons",
      "failureLayer",
      "failurePhase",
      "failureCause",
      "rootCause",
      "causeChain",
      "observed",
      "expected",
      "delta",
      "mutationStarted",
      "committed",
      "commitState",
      "sceneSaved",
      "persistedReadback",
      "evidence",
      "recovery",
      "nextAction"
    ],
    "requiredWhenReadyFalse": [
      "ready",
      "blockingReasons"
    ],
    "blockedCauseRequired": {
      "anyOf": ["failureCause", "rootCause", "causeChain", "delta"],
      "onMissing": "block_and_report_contract_failure"
    },
    "requiredForWrites": [
      "mutationStarted",
      "committed",
      "commitState",
      "sceneSaved",
      "persistedReadback"
    ],
    "requiredForUnknownCommit": [
      "commitState",
      "persistedReadback",
      "recovery",
      "nextAction"
    ],
    "unknownCommitAction": "read_back_before_retry",
    "missingCauseAction": "block_and_report_contract_failure"
  },
  "branchSelector": {
    "decision": "face_tracking_contract",
    "branches": [
      "gesture-only",
      "face-tracked"
    ],
    "faceTrackedRequires": [
      "mesh_blendshapes",
      "fx_and_gesture_animation",
      "expression_parameters",
      "expressions_menu"
    ],
    "allBranchesRequire": ["active_head_renderer_viseme_lipsync_and_expected_binding_closure"]
  },
  "headRendererConsumerClosureContract": {
    "requiredBeforeOldHeadRemoval": true,
    "activeRenderer": {
      "activeInHierarchy": true,
      "requiredTargets": ["descriptorVisemeSkinnedMesh", "descriptorLipSync", "allExpectedVisemeBindings", "allExpectedExpressionBindings", "allExpectedGestureBindings"],
      "bindingSetComparison": "exact_expected_source_or_accepted_baseline_paths_remapped_to_active_renderer",
      "blendShapeNamesMustResolve": true
    },
    "inactiveOrDonorRenderer": {
      "mayRemainDescriptorTarget": false,
      "mayRemainSoleAnimatorTarget": false,
      "maySatisfyExpectedBindingOnlyOnInactivePath": false
    },
    "requiredReadback": ["activeRendererPath", "activeRendererHierarchyState", "descriptorVisemeSkinnedMeshPath", "descriptorLipSyncMode", "expectedExpressionBindingPaths", "resolvedActiveRendererBindingPaths", "inactiveOrDonorBindingPaths", "missingBindingPaths", "orphanBindingPaths"],
    "faceTrackedBranch": {
      "requiredClosure": ["activeRendererBlendShapes", "fxControllerBindings", "expressionParameters", "expressionsMenu", "descriptorReferences"],
      "everyParameterAndMenuControlMustReachControllerAndActiveRendererConsumer": true,
      "everyExpectedControllerBlendShapeMustExistOnActiveRenderer": true,
      "inactiveOrDonorOnlyConsumerCount": 0
    },
    "failure": {
      "ready": false,
      "failureCauses": ["active_renderer_not_descriptor_viseme_target", "active_renderer_missing_expected_expression_binding", "inactive_or_donor_renderer_is_only_consumer", "face_tracking_parameter_menu_controller_blendshape_closure_incomplete"]
    }
  },
  "steps": [
    {
      "name": "inventory_and_select_branch",
      "tool": "vrcforge_read_avatar_descriptor",
      "tools": [
        "vrcforge_list_avatars",
        "vrcforge_read_avatar_descriptor",
        "vrcforge_scan_blendshapes",
        "vrcforge_scan_avatar_controls",
        "vrcforge_scan_parameters",
        "vrcforge_scan_fx_animator",
        "vrcforge_scan_animation_bindings"
      ],
      "writes": false
    },
    {
      "name": "inspect_neck_and_renderer_dependencies",
      "tool": "vrcforge_inspect_skinned_mesh_bone_usage",
      "tools": [
        "vrcforge_get_gameobject",
        "vrcforge_get_property",
        "vrcforge_scan_inbound_reference_closure",
        "vrcforge_inspect_skinned_mesh_bone_usage",
        "vrcforge_inspect_skinned_mesh_deformation"
      ],
      "writes": false
    },
    {
      "name": "community_unity_ma_merge_armature_replace_object_route",
      "tool": "vrcforge_preview_setup_outfit",
      "tools": ["vrcforge_preview_setup_outfit", "vrcforge_setup_outfit", "vrcforge_preview_add_modular_avatar_component", "vrcforge_add_modular_avatar_component", "vrcforge_get_property", "vrcforge_set_property"],
      "writes": true,
      "runtimeApprovalRequired": true,
      "onePreviewBoundMutationPerApproval": true,
      "sequence": ["match_overall_scale_in_unity", "place_head_prefab_under_target_avatar", "ma_setup_outfit", "ma_merge_armature_match_names_when_needed", "ma_replace_object_preserve_target_old_face_path", "mark_original_head_face_editor_only", "inspect_unobstructed_visible_neck_interface", "reconfigure_eye_lipsync_eyelids_viewpoint", "repair_fx_paths"],
      "capabilityGap": {"maReplaceObject": "blocked_manual_or_external_when_no_exact_atom", "meshHoleShrinker": "blocked_manual_or_external_when_no_exact_atom"},
      "matrixAnalysis": "prohibited_without_separate_explicit_authorization"
    },
    {
      "name": "scan_visible_head_body_materials_and_classify_neck_seam",
      "tool": "vrcforge_scan_materials",
      "tools": ["vrcforge_scan_materials", "vrcforge_get_property", "vrcforge_capture_status", "vrcforge_capture_screenshot"],
      "writes": false,
